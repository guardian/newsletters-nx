{
	"root": true,
	"overrides": [
		{
			"files": ["*.ts", "*.tsx"],
			"extends": ["@guardian/eslint-config-typescript"],
			"settings": {
				"import/resolver": {
					"typescript": {
						"project": "tsconfig.base.json"
					}
				}
			}
		},
		{
			"files": ["*.js", "*.jsx"],
			"extends": ["@guardian/eslint-config"]
		},
		{
			"files": ["*.spec.ts", "*.spec.tsx", "*.spec.js", "*.spec.jsx"],
			"env": {
				"jest": true
			},
			"rules": {}
		}
	],
	"ignorePatterns": ["!apps/*", "!libs/*"]
}
