{
	"extends": ["../../.eslintrc.json"],
	"ignorePatterns": [
		"!**/*",
		"**/vite.config.*.timestamp*",
		"**/vitest.config.*.timestamp*"
	],
	"overrides": [
		{
			"files": ["*.ts", "*.tsx"],
			"parserOptions": {
				"project": ["tsconfig.app.json"]
			},
			"rules": {}
		},
		{
			"files": ["*.spec.ts", "*.spec.tsx"],
			"parserOptions": {
				"project": ["tsconfig.spec.json"],
				"jest": true
			},
			"rules": {}
		}
	]
}
